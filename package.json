{
  "name": "rigbuilder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RigBuilder — an agent-native PC part picker powered by WebMCP.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:data": "tsx src/data/check.ts",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "d1:local": "wrangler d1 execute CATALOG --local",
    "catalog:migrate": "wrangler d1 migrations apply CATALOG --local",
    "catalog:migrate:remote": "wrangler d1 migrations apply CATALOG --remote",
    "catalog:import": "tsx scripts/catalog-import.ts",
    "catalog:import:remote": "tsx scripts/catalog-import.ts --remote",
    "catalog:reset": "tsx scripts/catalog-import.ts --reset",
    "catalog:reset:remote": "tsx scripts/catalog-import.ts --remote --reset",
    "cards": "tsx scripts/part-cards.ts",
    "cards:vendor": "tsx scripts/part-cards.ts --vendor",
    "cards:generic": "tsx scripts/part-cards.ts --generic",
    "cards:generic:import": "tsx scripts/import-generic-card.ts",
    "cards:publish": "tsx scripts/part-cards-publish.ts"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.0.0",
    "@mcp-b/webmcp-types": "latest",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
